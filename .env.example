# Groq API Key (Obtain from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face Token (Optional, for downloading gated models/higher rate limits)
HF_TOKEN=your_hugging_face_token_here

# Optional LLM Model Overrides (Defaults to active models on Groq)
# LLM_MODEL_SMART=openai/gpt-oss-120b
# LLM_MODEL_FAST=openai/gpt-oss-20b
